# Copy to .env for local use. Never commit .env.
# On Netlify, set these in Site configuration → Environment variables.

# sandbox (default) or live
PAYFAST_MODE=sandbox

# Public PayFast sandbox test account, from their docs.
# Replace all three with your own sandbox account, then with the live account.
# https://developers.payfast.co.za/docs/#step_2_create_security_signature
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=jt7NOE43FZPn

# At least 8 characters. Protects /admin.html.
ADMIN_PASSWORD=

# Hugo's inbox. Paid-order alerts, including each Temu link, go here.
ORDER_ALERT_EMAIL=

# Local dev. On Netlify set this to https://your-site.netlify.app
# or leave it unset so return, cancel and notify URLs use the request host.
SITE_URL=http://127.0.0.1:8888

# SMTP for the order alert. Any provider works (the host's SMTP, Gmail app password, etc.).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# file (local) or netlify-blobs (production). Leave unset to choose automatically.
ORDER_STORE=
